# ─────────────────────────────────────────────────────────────────────────────
# SmartHealth Hub — production server settings (docker-compose.server.yml)
#
# On the server:
#   cp .env.server.example .env.server
#   nano .env.server            # fill in every "change-me" value
#   chmod 600 .env.server
#
# .env.server is git-ignored. NEVER commit it.
# This one file feeds both docker compose (POSTGRES_*, API_DOMAIN) and the
# backend/worker/beat containers (everything else).
# ─────────────────────────────────────────────────────────────────────────────

# ── Domains ───────────────────────────────────────────────────────────────────
# Public hostname of THIS server's API. With no domain of your own, use sslip.io:
# it maps api.<your-IP-with-dashes>.sslip.io to your server's IP automatically,
# e.g. server IP 203.0.113.10  →  api.203-0-113-10.sslip.io
API_DOMAIN=api.203-0-113-10.sslip.io

# Your Vercel frontend URL (Project → Domains in the Vercel dashboard).
#   QR codes, passkeys and CORS all use it.
QR_BASE_URL=https://your-project.vercel.app
WEBAUTHN_ORIGIN=https://your-project.vercel.app
# Hostname only — no https://, no path.
WEBAUTHN_RP_ID=your-project.vercel.app
WEBAUTHN_RP_NAME=SmartHealth Hub
# JSON array.
CORS_ORIGINS=["https://your-project.vercel.app"]

# NFC chips open links on the API server directly: https://<API_DOMAIN>
NFC_VIEW_BASE_URL=https://api.203-0-113-10.sslip.io
# Signed chip links are required automatically in production. Only set this
# to false if you accept that sequential card numbers can be guessed.
# NFC_REQUIRE_SIGNED_LINKS=true

# ── Database (PostgreSQL container) ───────────────────────────────────────────
POSTGRES_DB=smarthealthhub
POSTGRES_USER=shh_admin
# Generate: openssl rand -hex 24   (hex avoids characters that break the URL)
POSTGRES_PASSWORD=change-me

# ── Secrets ───────────────────────────────────────────────────────────────────
# ENCRYPTION_KEY MUST be the exact value from your current backend\.env —
# a different key makes every encrypted diagnosis/treatment note unreadable.
ENCRYPTION_KEY=change-me-copy-from-current-backend-env
# Keep QR_HMAC_SECRET from backend\.env too, or every printed QR card and
# signed NFC link becomes invalid.
QR_HMAC_SECRET=change-me-copy-from-current-backend-env
# Generate a fresh one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (OTP delivery — required to log in) ─────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=change-me@gmail.com
EMAIL_HOST_PASSWORD=change-me-gmail-app-password
EMAIL_FROM_NAME=BHC-Verify

# ── SMS ───────────────────────────────────────────────────────────────────────
# semaphore | itexmo | philsms | textbee — copy the matching keys from backend\.env
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=BHCHealth
SEMAPHORE_WEBHOOK_SECRET=
ADMIN_ALERT_PHONE=

# ── Optional integrations (copy from backend\.env if you use them) ────────────
# OPENAI_API_KEY=
# OCR_PROVIDER=tesseract     # built into the image (English + Filipino)
# OCR_PROVIDER=azure needs the azure-ai-documentintelligence package added to
# backend/pyproject.toml first — it is not installed in the image.
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# BHC_NAME=Barangay Health Center

# ── Capacity ──────────────────────────────────────────────────────────────────
# uvicorn processes and Celery worker processes. 2 + 2 suits a 2 GB server.
API_WORKERS=2
WORKER_CONCURRENCY=2

# ── Backups (the `backup` service; all optional, defaults shown) ─────────────
# Daily time in Asia/Manila. Keep it before any VM auto-shutdown; a missed run
# is caught up automatically after the next start.
# BACKUP_TIME=22:30
# BACKUP_KEEP_DAYS=14
# Host folder for the backup files, and the uid:gid that owns them (run `id`).
# BACKUP_HOST_DIR=/var/backups/smarthealth
# BACKUP_OWNER=1000:1000
