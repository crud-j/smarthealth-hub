DATABASE_URL=postgresql+asyncpg://shh_admin:SmartHealthHub@localhost:5445/smarthealthhub
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
QR_HMAC_SECRET=<generate-with-openssl-rand-hex-32>
# Set to your LAN IP + port so QR codes work when scanned by mobile phones on the same Wi-Fi.
# Find your LAN IP: run `ipconfig` (Windows) and look for IPv4 Address.
# Example: QR_BASE_URL=http://192.168.1.100:3000
QR_BASE_URL=http://localhost:3000
SEMAPHORE_API_KEY=<your-semaphore-api-key>
# Sender name shown on the recipient's phone.
# "Semaphore" is the platform default — it works on any account with no approval
# required.  Custom names (e.g. "BHCNotify") require submitting an organizational
# consent form to Semaphore before they are activated; using an unapproved custom
# name causes HTTP 500 errors on every send.
# For thesis / development: keep this as "Semaphore".
# For production: replace with an approved custom name after consent is confirmed.
SEMAPHORE_SENDER_NAME=Semaphore
SEMAPHORE_WEBHOOK_SECRET=<optional-shared-secret-from-semaphore-dashboard>
SMS_REMINDER_LEAD_HOURS=24
SMS_MAX_RETRIES=3
SMS_IMMUNIZATION_LEAD_DAYS=3
ENCRYPTION_KEY=<32-byte-base64-encoded-aes-key>
# Must be a JSON array (pydantic-settings v2 requirement for list fields)
CORS_ORIGINS=["http://localhost:3000"]

# WebAuthn / Passkey configuration
# WEBAUTHN_RP_ID must match the domain the app is served from (no port).
# Use "localhost" for local development, "bhc.local" for LAN deployment.
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME is the human-readable app name shown in biometric prompts.
WEBAUTHN_RP_NAME=SmartHealth Hub
# WEBAUTHN_ORIGIN is the full origin (scheme + host + port) the browser sees.
# Must match exactly — wrong value causes all passkey assertions to fail.
WEBAUTHN_ORIGIN=http://localhost:3000

# NFC testing — school ID or any physical NFC card used as a test tap trigger.
# When set, reset_and_seed.py automatically links this UID to patient HC-2026-00001
# so /scan/<UID> works immediately after seeding without any manual Swagger steps.
# Use /view/HC-2026-XXXXX in NFC Tools Task URL to browse all other patients.
TEST_NFC_UID=C9:49:3B:07

# OCR / Document extraction
# OCR_PROVIDER=tesseract        # default: offline Tesseract (no API key needed)
# OCR_PROVIDER=azure            # optional: Azure Document Intelligence
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key-here
# OCR_MAX_IMAGE_BYTES=10485760  # 10 MB default
