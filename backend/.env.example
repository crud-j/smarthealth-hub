# ─────────────────────────────────────────────────────────────────────────────
# SmartHealth Hub — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env before starting the application:
#   cp backend/.env.example backend/.env
#
# The bootstrap script (scripts/bootstrap.sh) does this automatically.
#
# REQUIRED for production (must be set — app will refuse to start without them):
#   ENCRYPTION_KEY   — base64-encoded 32-byte AES-256-GCM key
#                      Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   JWT_SECRET_KEY   — minimum 32-character random string
#   SEMAPHORE_API_KEY (or ITEXMO_API_KEY / PHILSMS_TOKEN for alternative providers)
#
# OPTIONAL (leave blank to disable the feature):
#   OPENAI_API_KEY, AZURE_OCR_KEY, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://shh_admin:SmartHealthHub@localhost:5445/smarthealthhub
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
QR_HMAC_SECRET=<generate-with-openssl-rand-hex-32>
# Set to your LAN IP + port so QR codes work when scanned by mobile phones on the same Wi-Fi.
# Find your LAN IP: run `ipconfig` (Windows) and look for IPv4 Address.
# Example: QR_BASE_URL=http://192.168.1.100:3000
QR_BASE_URL=http://localhost:3000
# Base URL used when building the NFC chip NDEF URI record (view_url).
# NFC Tools encodes this URL on the chip; tapping the chip issues a GET to
# http://<NFC_VIEW_BASE_URL>/view/{card_number}.
# Set to your machine's LAN IP + the port uvicorn listens on (default 9000).
# Example: NFC_VIEW_BASE_URL=http://192.168.100.6:9000
NFC_VIEW_BASE_URL=http://192.168.100.6:9000

# SMS provider selection
# Valid values: "textbee" | "semaphore" | "itexmo" | "philsms"
# Recommended: "textbee" — no LOA, no sender registration, works immediately with
#              any Philippine SIM (Globe/Smart/DITO) via your own Android phone.
#              Semaphore/PhilSMS require sender name approval or registration.
SMS_PROVIDER=textbee

# ─── textbee (recommended — no LOA, works with any PH SIM) ──────────────────
# Setup (5 minutes, no credit card):
#   1. Sign up at https://textbee.dev (free tier: 50 msgs/day, 300/month)
#   2. Install the textbee Android app on any Android 7.0+ phone with a PH SIM
#   3. Tap "Register device" in the app and enter your API key
#   4. Copy your API key and device ID from the dashboard
#
# Pro plan ($9.99/month): 5,000 msgs/month, no daily cap, up to 5 devices.
#
# IMPORTANT: Keep the Android phone permanently plugged in at the health center.
# SMS delivery depends on the device being powered and connected to data/Wi-Fi.
# Celery retries (SMS_MAX_RETRIES=3) handle transient device-offline gaps.
TEXTBEE_API_KEY=<your-textbee-api-key>
# Device ID from the textbee.dev dashboard (Settings → Devices → copy device ID).
# Leave blank to use textbee's auto-selection (picks the device with the most
# recent heartbeat — correct for a single-device setup).
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# ─── Semaphore (fallback option) ─────────────────────────────────────────────
# Sign up at https://semaphore.co — free account, no sender ID registration needed.
# Get your API key from: Dashboard → API (top right menu)
# SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
# "SEMAPHORE" is the free platform default sender name — works on any account with
# zero registration or approval required.  Messages arrive as "SEMAPHORE" on the
# recipient's phone.
# Custom sender names (e.g. "BHCNotify") require an organizational consent form
# submitted to Semaphore; PhilSMS custom IDs require ₱3,000 registration.
# For thesis / development: keep this as "SEMAPHORE".
SEMAPHORE_SENDER_NAME=Semaphore
# Optional: shared secret for validating Semaphore delivery-status webhook callbacks.
# Find it in the Semaphore dashboard under Webhooks / Delivery Reports (if available).
# Leave blank to skip signature validation — webhook callbacks are still logged.
SEMAPHORE_WEBHOOK_SECRET=

# ─── iTExmo (alternative — no LOA required; sign up at itexmo.com) ───────────
# SMS_PROVIDER=itexmo
ITEXMO_API_KEY=
ITEXMO_EMAIL=

# ─── PhilSMS (alternative — note: custom sender ID costs ₱3,000 to register) ─
# Use PHILSMS_SENDER_ID=PhilSMS (free platform default) to avoid registration cost.
# SMS_PROVIDER=philsms
PHILSMS_TOKEN=
PHILSMS_SENDER_ID=PhilSMS
# IMPORTANT: no trailing slash — the service appends "/send" to build the full URL.
# Correct endpoint: https://dashboard.philsms.com/api/v3/sms/send
PHILSMS_BASE_URL=https://dashboard.philsms.com/api/v3/sms

SMS_REMINDER_LEAD_HOURS=24
SMS_MAX_RETRIES=3
SMS_IMMUNIZATION_LEAD_DAYS=3
# Admin phone for system alerts (E.164 format, e.g. +639171234567).
# When set, the Celery worker sends an SMS alert when a reminder task fails
# permanently (all retries exhausted) or when ≥5 failures occur in 24 hours.
# Leave blank to disable admin alert SMS.
ADMIN_ALERT_PHONE=
ENCRYPTION_KEY=<32-byte-base64-encoded-aes-key>

# Email / Gmail SMTP (used to send MFA OTPs via asyncio.to_thread + smtplib)
# Use a Gmail App Password here — NOT your Google account password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=<gmail-app-password-not-account-password>
EMAIL_FROM_NAME=BHC-Verify

# Scheduled analytics report emails (sent by Celery Beat to all active admin users)
# Set to false to disable the automated weekly and monthly summary emails.
REPORT_EMAIL_ENABLED=true

# Media / uploads
# MEDIA_DIR=/absolute/path/to/media  # optional; defaults to backend/media/
MAX_PHOTO_UPLOAD_BYTES=5242880

# AI Analytics (optional — leave blank to disable AI features)
# Used by ai_service.py for no-show risk scoring and anomaly alert generation.
# Falls back to threshold-only logic when unset.
OPENAI_API_KEY=

# Must be a JSON array (pydantic-settings v2 requirement for list fields)
CORS_ORIGINS=["http://localhost:3000"]

# WebAuthn / Passkey configuration
# WEBAUTHN_RP_ID must match the domain the app is served from (no port).
# Use "localhost" for local development, "bhc.local" for LAN deployment.
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME is the human-readable app name shown in biometric prompts.
WEBAUTHN_RP_NAME=SmartHealth Hub
# WEBAUTHN_ORIGIN is the full origin (scheme + host + port) the browser sees.
# Must match exactly — wrong value causes all passkey assertions to fail.
WEBAUTHN_ORIGIN=http://localhost:3000

# NFC testing — school ID or any physical NFC card used as a test tap trigger.
# When set, reset_and_seed.py automatically links this UID to patient HC-2026-00001
# so /scan/<UID> works immediately after seeding without any manual Swagger steps.
# Use /view/HC-2026-XXXXX in NFC Tools Task URL to browse all other patients.
TEST_NFC_UID=C9:49:3B:07

# OCR / Document extraction
# OCR_PROVIDER=tesseract        # default: offline Tesseract (no API key needed)
# OCR_PROVIDER=azure            # optional: Azure Document Intelligence
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key-here
# OCR_MAX_IMAGE_BYTES=10485760  # 10 MB default
