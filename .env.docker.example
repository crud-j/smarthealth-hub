# ─────────────────────────────────────────────────────────────────────────────
# SmartHealth Hub — .env.docker.example
#
# Template for running the full stack via docker compose.
# Copy to backend/.env and fill in real values before running:
#   cp .env.docker.example backend/.env
#
# The docker-compose.yml uses backend/.env as env_file for the backend,
# worker, and beat services.  Postgres credentials here must match the
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB values also in this file.
#
# NEVER commit a file containing real secrets.  This file contains only
# placeholder values and is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# "development" | "production"
# Controls: secure-cookie flag, dev-OTP endpoint access, startup guards.
ENVIRONMENT=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# These vars are read by the `db` service directly, and also embedded in the
# DATABASE_URL below for the backend/worker services.
POSTGRES_DB=smarthealthhub
POSTGRES_USER=shh_admin
POSTGRES_PASSWORD=change-me-strong-password

# Full async DSN used by SQLAlchemy.  When running via docker compose, the host
# must be the service name "db", not "localhost".
DATABASE_URL=postgresql+asyncpg://shh_admin:change-me-strong-password@db:5432/smarthealthhub

# ── Redis ─────────────────────────────────────────────────────────────────────
# When running via docker compose, the host must be the service name "redis".
REDIS_URL=redis://redis:6379/0

# ── Port bindings (host-side) ─────────────────────────────────────────────────
# Change these if the default ports conflict with something already running.
DB_HOST_PORT=5445
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── QR / NFC Card Signing ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
QR_HMAC_SECRET=change-me-generate-with-openssl-rand-hex-32

# Base URL embedded in QR codes.  Set to the LAN IP or public domain so QR
# codes scanned by mobile phones resolve correctly.
# Example: QR_BASE_URL=http://192.168.1.100:3000
QR_BASE_URL=http://localhost:3000

# ── Application-layer Encryption (AES-256-GCM) ────────────────────────────────
# Base64-encoded 32-byte key.  Encrypts: medical_history.notes, visits.diagnosis,
# visits.treatment_notes.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=change-me-base64-encoded-32-byte-aes-key

# ── Semaphore SMS ─────────────────────────────────────────────────────────────
SEMAPHORE_API_KEY=your-semaphore-api-key-here
SEMAPHORE_SENDER_NAME=BHCHealth
# Shared secret for validating X-Semaphore-Signature on delivery webhooks.
# Leave empty in development (validation is skipped when this is unset).
SEMAPHORE_WEBHOOK_SECRET=

# ── SMS Reminder Scheduling ───────────────────────────────────────────────────
SMS_REMINDER_LEAD_HOURS=24
SMS_MAX_RETRIES=3
SMS_IMMUNIZATION_LEAD_DAYS=3

# ── Email / Gmail SMTP (OTP delivery) ────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail-address@gmail.com
# Generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
EMAIL_FROM_NAME=BHC-Verify
EMAIL_USE_TLS=true

# ── WebAuthn / Passkey ────────────────────────────────────────────────────────
# Must match the domain the browser sees — no port.
# Use "localhost" for local dev, "bhc.local" for LAN deployment.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SmartHealth Hub
# Full origin (scheme + host + port) the browser sees.
WEBAUTHN_ORIGIN=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must be a JSON array (pydantic-settings v2 requirement for list fields).
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Media Storage ─────────────────────────────────────────────────────────────
# Absolute path inside the container where uploaded patient photos are stored.
# The docker-compose.yml binds ./backend/media to this path.
MEDIA_DIR=/app/media
